---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Reveal from '../components/Reveal.astro';
import { href } from '../data/site';
import serifFont from '@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2?url';
import sansFont from '@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url';
import '../styles/global.css';
import '../styles/tokens.css';
import '../styles/motion.css';
import '../styles/refinement.css';
interface Props { title: string; description: string; current?: string; }
const { title, description, current = '' } = Astro.props;
const canonical = new URL(href(current), Astro.site);
const page = current.replaceAll('/', '') || 'inicio';
---
<!doctype html>
<html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin="anonymous" /><link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin="anonymous" /><meta name="theme-color" content="#243D3A" /><title>{title} · Demo</title><meta name="description" content={description} /><meta name="robots" content="noindex, follow" /><link rel="canonical" href={canonical} /><link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" href={`${href('favicon.ico')}?v=2`} /><link rel="icon" type="image/png" sizes="32x32" href={`${href('favicon-32.png')}?v=2`} /><link rel="icon" type="image/svg+xml" sizes="any" href={`${href('favicon.svg')}?v=2`} /><link rel="apple-touch-icon" sizes="180x180" href={`${href('apple-touch-icon.png')}?v=2`} /><meta property="og:title" content={`${title} · Demo de diseño`} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:locale" content="es_ES" /><meta property="og:url" content={canonical} /></head><body class="motion-enabled" data-page={page}><a class="skip-link" href="#contenido">Saltar al contenido</a><Header current={current} /><main id="contenido" tabindex="-1"><slot /></main><Footer /><Reveal /></body></html>
