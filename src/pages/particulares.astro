---
import Arrow from '../components/Arrow.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceBlock from '../components/ServiceBlock.astro';
import ContactCta from '../components/ContactCta.astro';
import { href } from '../data/site';
---
<Layout current="particulares/" title="Servicios jurídicos para particulares | Jaime Valiente" description="Asuntos civiles, de familia y sucesiones y penales. Propuesta de servicios para particulares.">
<PageHero eyebrow="Particulares" title="Servicios jurídicos para particulares." description="Asesoramiento en asuntos civiles, de familia y sucesiones y penales. Conoce las áreas de actuación y contacta con el despacho para plantear tu situación." />
<div class="shell area-layout"><nav class="area-nav" aria-label="Áreas para particulares"><p>En esta página</p><a href="#civil">Derecho civil</a><a href="#familia">Familia y sucesiones</a><a href="#penal">Derecho penal</a></nav><div>
<ServiceBlock id="civil" number="01" title="Derecho civil" intro="Asesoramiento en contratos y obligaciones, responsabilidad civil e indemnizaciones y procedimientos judiciales civiles." items={['Contratos y obligaciones','Responsabilidad civil e indemnizaciones','Procedimientos judiciales civiles']}><p class="related-link">Si tu consulta se refiere a una cantidad pendiente de pago, consulta <a href={href('reclamaciones/')}>Reclamaciones de cantidad</a>.</p></ServiceBlock>
<section id="familia" class="service-block" tabindex="-1" aria-labelledby="familia-title"><div class="service-title"><span class="section-number">02</span><h2 id="familia-title">Familia<br />y sucesiones</h2></div><div class="service-body"><p class="service-intro">Asesoramiento en asuntos familiares y sucesorios. Consulta el alcance de cada servicio para plantear tu situación.</p><h3>Familia</h3><ul class="service-list"><li>Divorcios y separaciones</li><li>Guarda y custodia</li><li>Pensiones de alimentos</li><li>Liquidación del régimen económico matrimonial</li></ul><h3>Herencias y sucesiones</h3><ul class="service-list"><li>Herencias y sucesiones</li><li>Testamentos y cuadernos particionales</li><li>Adjudicación y reparto de bienes hereditarios</li><li>Conflictos entre herederos</li></ul><a class="text-link" href={href('contacto/')}>Consultar sobre familia o herencias <Arrow /></a></div></section>
<ServiceBlock id="penal" number="03" title="Derecho penal" intro="Asistencia y defensa penal y acusación particular. Contacta para consultar la atención de tu asunto." items={['Asistencia y defensa penal','Acusación particular','Denuncias y querellas','Delitos contra las personas y el patrimonio']} />
<p class="small-note">Para iniciar el contacto, indica brevemente el área de tu consulta y cómo contactar contigo. Si hay una notificación o una fecha relevante, comunícalo al despacho. No envíes expedientes ni datos de terceros por el primer mensaje.</p></div></div>
<ContactCta title="Plantea tu consulta." action="Solicitar consulta" />
</Layout>
