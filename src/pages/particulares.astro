---
import Arrow from '../components/Arrow.astro';
import AreaNav from '../components/AreaNav.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceBlock from '../components/ServiceBlock.astro';
import ContactCta from '../components/ContactCta.astro';
import { href } from '../data/site';
---
<Layout current="particulares/" title="Servicios jurídicos para particulares | Jaime Valiente" description="Asuntos civiles, de familia y sucesiones y penales. Propuesta de servicios para particulares.">
<PageHero eyebrow="Particulares" title="Servicios jurídicos para particulares." description="Asuntos civiles, de familia, sucesiones y penales. Encuentra el área de tu consulta." />
<div class="shell area-layout"><AreaNav audience="particulares" areas={[{id:'civil',label:'Derecho civil'},{id:'familia',label:'Familia y sucesiones'},{id:'penal',label:'Derecho penal'}]} /><div>
<ServiceBlock id="civil" number="01" title="Derecho civil" items={['Contratos y obligaciones','Responsabilidad civil e indemnizaciones','Procedimientos judiciales civiles']}><p class="related-link">Para cantidades pendientes de cobro, consulta <a href={href('reclamaciones/')}>Reclamaciones de cantidad</a>.</p></ServiceBlock>
<section id="familia" class="service-block" tabindex="-1" aria-labelledby="familia-title"><div class="service-title"><span class="section-number">02</span><h2 id="familia-title">Familia<br />y sucesiones</h2></div><div class="service-body"><h3>Familia</h3><ul class="service-list"><li>Divorcios y separaciones</li><li>Guarda y custodia</li><li>Pensiones de alimentos</li><li>Liquidación del régimen económico matrimonial</li></ul><h3>Herencias y sucesiones</h3><ul class="service-list"><li>Herencias y sucesiones</li><li>Testamentos y cuadernos particionales</li><li>Adjudicación y reparto de bienes hereditarios</li><li>Conflictos entre herederos</li></ul><a class="text-link" href={href('contacto/')}>Consultar sobre familia o herencias <Arrow /></a></div></section>
<ServiceBlock id="penal" number="03" title="Derecho penal" items={['Asistencia y defensa penal','Acusación particular','Denuncias y querellas','Delitos contra las personas y el patrimonio']} />
<p class="small-note">Para iniciar el contacto, indica brevemente el área de tu consulta y cómo contactar contigo. Si hay una notificación o una fecha relevante, comunícalo al despacho. No envíes expedientes ni datos de terceros por el primer mensaje.</p></div></div>
<ContactCta title="Plantea tu consulta." action="Solicitar consulta" />
</Layout>
