---
import Layout from '../layouts/Layout.astro';
import { href } from '../data/site';
import Arrow from '../components/Arrow.astro';
---
<Layout current="404.html" title="Página no encontrada | Jaime Valiente Abogado" description="La dirección solicitada no está disponible en esta demo."><div class="shell"><section class="not-found"><p class="eyebrow">Error 404</p><h1>No encontramos<br />esta página.</h1><p>La dirección puede haber cambiado o no existir. Puedes volver al inicio o consultar los medios de contacto del despacho.</p><div class="hero-buttons"><a class="button button-dark" href={href()}>Volver al inicio<Arrow /></a><a class="button button-outline" href={href('contacto/')}>Ir a Contacto<Arrow /></a></div></section></div></Layout>
