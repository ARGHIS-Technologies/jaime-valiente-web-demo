---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceBlock from '../components/ServiceBlock.astro';
import ContactCta from '../components/ContactCta.astro';
import { href } from '../data/site';
---
<Layout current="reclamaciones/" title="Reclamación de deudas | Jaime Valiente Abogado" description="Deudas, procedimientos monitorios, negociación y ejecución de resoluciones judiciales. Demo de diseño.">
<PageHero eyebrow="Reclamaciones" title="Reclamación de deudas y ejecución de resoluciones." description="Servicios de reclamación judicial de deudas, procedimientos monitorios, ejecución de resoluciones judiciales y negociación para la resolución extrajudicial de conflictos. Una vía de consulta para particulares y empresas con cantidades pendientes de cobro." action="Consultar una reclamación" />
<div class="shell area-layout"><nav class="area-nav" aria-label="Ámbitos de reclamación"><p>En esta página</p><a href="#deuda">Deudas</a><a href="#negociacion">Negociación</a><a href="#judicial">Reclamación judicial</a><a href="#ejecucion">Ejecución</a></nav><div>
<ServiceBlock id="deuda" number="01" title="Deudas pendientes" intro="Si necesitas consultar una deuda, contacta con el despacho para exponer brevemente su origen y tu situación. La vía de actuación deberá valorarse según el asunto." items={[]} action="Consultar una deuda" />
<ServiceBlock id="negociacion" number="02" title="Negociación extrajudicial" intro="Asesoramiento en negociación y resolución extrajudicial de conflictos. Contacta con el despacho para consultar su encaje en tu asunto." items={[]} action="Consultar sobre negociación" />
<ServiceBlock id="judicial" number="03" title="Reclamación judicial y monitorios" intro="Asesoramiento en reclamaciones judiciales de deudas y procedimientos monitorios. Contacta para consultar qué atención puede ofrecerte el despacho." items={[]} action="Consultar una reclamación" />
<ServiceBlock id="ejecucion" number="04" title="Ejecución de resoluciones" intro="Si tu consulta se relaciona con el cumplimiento de una resolución judicial, explica brevemente qué necesitas al solicitar la consulta; la actuación dependerá de la valoración del asunto." items={[]} action="Consultar sobre ejecución" />
<p class="small-note">Esta información no determina si una reclamación es viable ni qué procedimiento corresponde. El primer contacto no supone la aceptación del encargo ni garantiza un resultado.</p><div class="related-grid"><article class="related-card"><h3>Otros asuntos civiles</h3><p>Responsabilidad civil, indemnizaciones y otros asuntos personales.</p><a class="text-link" href={href('particulares/#civil')}>Ver Derecho civil <span aria-hidden="true">→</span></a></article><article class="related-card"><h3>Reclamaciones laborales</h3><p>Despidos, sanciones y reclamaciones laborales de empresas y autónomos.</p><a class="text-link" href={href('empresas/#laboral')}>Ver el área laboral <span aria-hidden="true">→</span></a></article></div></div></div>
<ContactCta title="Consulta tu reclamación." action="Contactar con el despacho" />
</Layout>
