---
import Arrow from '../components/Arrow.astro';
import AreaNav from '../components/AreaNav.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceBlock from '../components/ServiceBlock.astro';
import ContactCta from '../components/ContactCta.astro';
import { href } from '../data/site';
---
<Layout current="reclamaciones/" title="Reclamación de deudas | Jaime Valiente Abogado" description="Deudas, procedimientos monitorios, negociación y ejecución de resoluciones judiciales.">
<PageHero eyebrow="Reclamaciones" title="Reclamación de deudas." description="Negociación, reclamación judicial de deudas y ejecución de resoluciones. Para particulares y empresas con cantidades pendientes de cobro." action="Consultar una reclamación" />
<div class="shell area-layout"><AreaNav audience="reclamaciones" areas={[{id:'deuda',label:'Deudas'},{id:'negociacion',label:'Negociación'},{id:'judicial',label:'Reclamación judicial'},{id:'ejecucion',label:'Ejecución'}]} /><div>
<ServiceBlock id="deuda" title="Deudas pendientes" intro="Expón el origen de la deuda y tu situación. La vía de actuación dependerá de la valoración del asunto." items={[]} action="Consultar una deuda" />
<ServiceBlock id="negociacion" title="Negociación extrajudicial" intro="Negociación para la resolución extrajudicial de conflictos, según las circunstancias del asunto." items={[]} action="Consultar sobre negociación" />
<ServiceBlock id="judicial" title="Reclamación judicial y monitorios" intro="Reclamación judicial de deudas y procedimientos monitorios, previa valoración de la vía aplicable." items={[]} action="Consultar una reclamación" />
<ServiceBlock id="ejecucion" title="Ejecución de resoluciones" intro="Asesoramiento sobre el cumplimiento de resoluciones judiciales. La actuación dependerá de la valoración del asunto." items={[]} action="Consultar sobre ejecución" />
<p class="small-note">Esta información no determina si una reclamación es viable ni qué procedimiento corresponde. El primer contacto no supone la aceptación del encargo ni garantiza un resultado.</p><div class="related-grid"><article class="related-card"><h3>Otros asuntos civiles</h3><p>Responsabilidad civil, indemnizaciones y otros asuntos personales.</p><a class="text-link" href={href('particulares/#civil')}>Ver Derecho civil <Arrow /></a></article><article class="related-card"><h3>Reclamaciones laborales</h3><p>Despidos, sanciones y reclamaciones laborales de empresas y autónomos.</p><a class="text-link" href={href('empresas/#laboral')}>Ver el área laboral <Arrow /></a></article></div></div></div>
<ContactCta title="Consulta tu reclamación." action="Contactar con el despacho" />
</Layout>
