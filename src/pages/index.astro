---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import Offices from '../components/Offices.astro';
import ContactCta from '../components/ContactCta.astro';
import ServiceGuide from '../components/ServiceGuide.astro';
import { href } from '../data/site';
const areas = [
  { title: 'Particulares', path: 'particulares/' },
  { title: 'Empresas', path: 'empresas/' },
  { title: 'Reclamaciones', path: 'reclamaciones/' },
];
const personal = [
  { title: 'Derecho civil', text: 'Contratos y responsabilidad civil.', path: 'particulares/#civil' },
  { title: 'Familia y sucesiones', text: 'Familia, divorcios y herencias.', path: 'particulares/#familia' },
  { title: 'Derecho penal', text: 'Defensa y acusación particular.', path: 'particulares/#penal' },
];
const business = [
  { title: 'Jurídico y mercantil', text: 'Sociedades y contratos mercantiles.', path: 'empresas/#mercantil' },
  { title: 'Asesoramiento laboral', text: 'Contratación y gestión de nóminas.', path: 'empresas/#laboral' },
  { title: 'Contable y fiscal', text: 'Contabilidad e impuestos.', path: 'empresas/#contable-fiscal' },
];
---
<Layout title="Jaime Valiente Alemán | Abogado en Cádiz y Arcos" description="Demo de diseño. Asesoramiento jurídico para particulares y asesoramiento a empresas y autónomos en Cádiz y Arcos de la Frontera.">
  <section class="home-hero">
    <div class="shell">
      <div class="hero-layout">
        <div class="hero-copy">
          <p class="eyebrow">Jaime Valiente Alemán · Abogado</p>
          <h1>Tu abogado,<br /><em>en Cádiz y Arcos.</em></h1>
          <p class="home-intro">Asesoramiento jurídico para tus asuntos personales. Atención jurídica y mercantil, laboral, contable y fiscal para empresas y autónomos.</p>
          <div class="hero-buttons"><a class="button button-dark" href={href('contacto/')}>Solicitar consulta<Arrow /></a><a class="hero-secondary" href="#servicios">Explorar los servicios <Icon name="arrow-down" class="hero-direction" size={18} /></a></div>
        </div>
        <aside class="hero-index" aria-label="Encuentra tu área de consulta">
          <p class="hero-index-label">¿Qué necesitas consultar?</p>
          {areas.map(area => <a href={href(area.path)}><strong>{area.title}</strong><Arrow /></a>)}
          <p class="hero-index-note"><a href={href('contacto/')}>Consultar al despacho <Icon name="arrow-right" size={16} /></a></p>
        </aside>
      </div>
    </div>
  </section>
  <section id="servicios" class="section services-section" tabindex="-1" aria-labelledby="servicios-title">
    <div class="shell">
      <div class="services-heading"><h2 id="servicios-title">Asuntos personales.<br />Actividad profesional.</h2><p>Consulta las especialidades del despacho y accede a la información relacionada con tu situación.</p></div>
      <div class="practice-grid">
        <ServiceGuide title="Particulares" items={personal} />
        <ServiceGuide title="Empresas y autónomos" items={business} business />
      </div>
      <div class="debt-feature"><div><p class="eyebrow">Reclamaciones</p><h3>Deudas pendientes.</h3></div><p>Negociación, reclamación judicial, monitorios y ejecución de resoluciones.</p><a class="text-link" href={href('reclamaciones/')}>Consultar Reclamaciones<Arrow /></a></div>
    </div>
  </section>
  <section class="statement-section">
    <div class="shell">
      <div class="statement-grid">
        <div class="identity-note"><p class="eyebrow">El despacho</p><h2 class="identity-title">Jaime Valiente<br />Alemán.</h2><p>Abogado · Cádiz y Arcos de la Frontera</p></div>
        <div class="statement-detail"><p class="statement-lead">Escuchar tu situación.<br />Asesorar con rigor.</p><p class="statement-copy">Atención cercana, personalizada y transparente para tus asuntos personales y profesionales.</p><a class="text-link" href={href('el-despacho/')}>Conocer a Jaime Valiente<Arrow /></a></div>
      </div>
      <div class="statement-client"><p>¿Ya eres cliente del despacho?</p><a class="text-link" href={href('area-clientes/')}><Icon name="folder-simple" />Consultar el envío de documentación</a></div>
    </div>
  </section>
  <section class="section locations-section">
    <div class="shell">
      <div class="locations-heading"><h2>Cádiz y Arcos de la Frontera.</h2><p>Dos ubicaciones. Contacta para consultar las condiciones de atención antes de desplazarte.</p></div>
      <Offices />
      <p class="location-disclaimer">Datos publicados en la web actual, pendientes de ratificación para la versión definitiva. La grafía de las direcciones y los edificios se conserva como figura en la auditoría.</p>
    </div>
  </section>
  <ContactCta title="Hablemos de tu consulta." action="Solicitar consulta" description="Explica brevemente qué necesitas y consulta las condiciones de atención. Evita enviar documentación sensible en el primer mensaje." />
</Layout>
