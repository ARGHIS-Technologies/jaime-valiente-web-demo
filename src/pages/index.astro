---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Offices from '../components/Offices.astro';
import ContactCta from '../components/ContactCta.astro';
import { href } from '../data/site';
const areas = [
  { number:'01', category:'Asuntos personales', title:'Particulares', text:'Contratos, responsabilidad civil, familia, herencias y asuntos penales.', path:'particulares/', action:'Ver servicios para particulares' },
  { number:'02', category:'Tu actividad profesional', title:'Empresas', text:'Asesoramiento jurídico y mercantil, laboral, contable y fiscal para empresas y autónomos.', path:'empresas/', action:'Ver servicios para empresas' },
  { number:'03', category:'Deudas y resoluciones', title:'Reclamaciones', text:'Deudas, procedimientos monitorios, ejecución de resoluciones y negociación.', path:'reclamaciones/', action:'Consultar reclamaciones' },
];
---
<Layout title="Jaime Valiente Abogado en Cádiz y Arcos" description="Demo de diseño. Asesoramiento jurídico para particulares, empresas y autónomos en Cádiz y Arcos de la Frontera.">
  <section class="home-hero"><div class="shell"><div class="hero-topline"><p class="eyebrow">Jaime Valiente Abogado</p><span class="hero-meta">Particulares · Empresas · Reclamaciones</span></div><div class="hero-layout"><div><h1>Asesoramiento<br />jurídico y empresarial<span class="location-line">en Cádiz y Arcos de la Frontera</span></h1><p class="home-intro">Jaime Valiente Abogado ofrece asesoramiento a particulares, autónomos y empresas en asuntos civiles, de familia y sucesiones, penales y empresariales. Consulta los servicios y contacta con el despacho para plantear tu asunto.</p><div class="hero-buttons"><a class="button button-dark" href={href('contacto/')}>Solicitar cita<Arrow /></a><a class="button button-outline" href="#servicios">Ver servicios <span aria-hidden="true">↓</span></a></div></div><aside class="hero-signature" aria-label="Valores del despacho"><p class="signature-label">Cercanía · Rigor · Transparencia</p><p class="signature-statement">Una atención <br />cercana.<br /><em>Un criterio <br />riguroso.</em></p><p class="signature-footer">Cádiz & Arcos de la Frontera</p></aside></div><div class="hero-bottom"><span>Un primer paso para tu consulta</span><a href={href('contacto/')}>Hablemos de tu asunto <Arrow /></a></div></div></section>
  <section id="servicios" class="section"><div class="shell"><div class="section-header"><div><p class="eyebrow">Áreas de actuación</p><h2>Servicios según<br />tu necesidad.</h2></div><p>Asesoramiento para los asuntos personales y las necesidades de tu actividad profesional. Encuentra el área relacionada con tu consulta.</p></div><div class="service-cards">{areas.map(area => <article class="service-card"><div class="service-card-top"><span class="section-number">{area.number}</span><span class="service-card-category">{area.category}</span></div><h3>{area.title}</h3><p>{area.text}</p><a class="text-link" href={href(area.path)}>{area.action}<Arrow /></a></article>)}</div></div></section>
  <section class="statement-section"><div class="shell statement-grid"><div class="editorial-stamp" aria-hidden="true"><div class="stamp-frame"><span>ASESORAMIENTO JURÍDICO Y EMPRESARIAL</span><strong>Jaime<br />Valiente.</strong><em>Abogado</em></div></div><div><p class="eyebrow">El despacho</p><h2>Atención cercana.<br /><em>Rigor y transparencia.</em></h2><p class="statement-copy">Atención jurídica y empresarial con cercanía, rigor y transparencia. Conoce los datos del despacho y los medios de contacto.</p><a class="text-link" href={href('el-despacho/')}>Conocer el despacho<Arrow /></a></div></div></section>
  <section class="section"><div class="shell consultation-grid"><div><p class="eyebrow">Antes de una consulta</p><h2>Empieza por<br />contarnos qué necesitas.</h2></div><div class="consultation-copy"><p>Contacta para explicar brevemente qué necesitas y consultar las condiciones de atención. Evita enviar documentación sensible en el primer mensaje.</p><a class="text-link" href={href('contacto/')}>Ver los medios de contacto<Arrow /></a><div class="client-note"><p>¿Ya eres cliente del despacho?</p><a class="text-link" href={href('area-clientes/')}>Ir al Área de clientes<Arrow /></a></div></div></div></section>
  <section class="section locations-section"><div class="shell"><div class="section-header"><div><p class="eyebrow">Ubicaciones publicadas</p><h2>Cádiz y Arcos<br />de la Frontera.</h2></div><p>Consulta los datos de contacto del despacho y las condiciones de atención al solicitar tu cita.</p></div><Offices /><p class="location-disclaimer">Datos publicados en la web actual, pendientes de ratificación para la versión definitiva. La grafía de las direcciones y los edificios se conserva como figura en la auditoría.</p></div></section>
  <ContactCta title="¿Quieres plantear una consulta?" action="Solicitar cita" description="Contacta con el despacho. El primer contacto permite consultar la atención y las condiciones de tu asunto." />
</Layout>
