---
import Layout from '../layouts/Layout.astro';
import VisualStudy from '../components/VisualStudy.astro';
import { visualStudies } from '../data/visualStudies';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import Offices from '../components/Offices.astro';
import ContactCta from '../components/ContactCta.astro';
import { href } from '../data/site';
---
<Layout current="el-despacho/" title="El despacho | Jaime Valiente Abogado" description="Presentación y datos disponibles del despacho. Propuesta visual con información profesional pendiente de validación.">
<section class="profile-hero"><div class="shell">
  <div class="breadcrumb"><a href={href()}>Inicio</a><span aria-hidden="true">/</span><span>El despacho</span></div>
  <div class="profile-visual-layout"><div><h1>Jaime Valiente<br />Alemán.</h1>
  <div class="profile-intro"><p>Asesoramiento jurídico y empresarial en Cádiz y Arcos de la Frontera. Atención cercana, personalizada, rigurosa y transparente.</p><a class="button button-light" href={href('contacto/')}>Solicitar consulta<Arrow /></a></div>
</div><VisualStudy study={visualStudies.portrait} tone="dark" eager /></div></div></section>
<section class="section profile-section"><div class="shell profile-body"><div><h2>Asuntos personales.<br />Actividad profesional.</h2><p class="lead">Asesoramiento para tus asuntos personales y las necesidades de tu actividad profesional.</p><p>Puedes consultar asuntos civiles, de familia y sucesiones, penales y de reclamación de deudas, así como necesidades mercantiles, laborales, contables y fiscales.</p><details class="verification-list verification-disclosure"><summary><span>Demo · Información profesional pendiente</span><Icon name="plus" class="disclosure-icon" /></summary><div class="verification-content"><h3>Datos a validar con el despacho</h3><ul><li>Titular legal y datos de identificación del prestador.</li><li>Titulación, colegio y número de colegiado.</li><li>Biografía contrastada y fotografía real autorizada.</li><li>Condiciones de atención y vigencia de los servicios.</li></ul><p class="small-note">Esta demo no atribuye trayectoria, acreditaciones, equipo, testimonios ni resultados que no estén documentados.</p></div></details></div><nav class="profile-services" aria-label="Servicios del despacho"><p>Consulta los servicios</p><a class="text-link" href={href('particulares/')}>Particulares<Arrow /></a><a class="text-link" href={href('empresas/')}>Empresas y autónomos<Arrow /></a><a class="text-link" href={href('reclamaciones/')}>Reclamaciones<Arrow /></a></nav></div></section>
<section class="visual-story"><div class="shell"><div class="visual-story-heading"><h2>Estudios de luz y espacio.</h2><p>Composiciones provisionales para definir el tono y el encuadre de las futuras fotografías.</p></div><div class="visual-story-pair"><VisualStudy study={visualStudies.interior} /><VisualStudy study={visualStudies.work} /></div></div></section>
<section class="section locations-section"><div class="shell"><div class="section-header"><div><h2>Cádiz y Arcos.</h2></div><p>Direcciones publicadas en la web actual. Su grafía y las condiciones de atención deben ratificarse antes de una publicación definitiva.</p></div><Offices /></div></section><ContactCta title="Hablemos de tu consulta." />
</Layout>
