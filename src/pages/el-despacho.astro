---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Offices from '../components/Offices.astro';
import ContactCta from '../components/ContactCta.astro';
import { href } from '../data/site';
---
<Layout current="el-despacho/" title="El despacho | Jaime Valiente Abogado" description="Presentación y datos disponibles del despacho. Propuesta visual con información profesional pendiente de validación.">
<PageHero eyebrow="El despacho · Abogado" title="Jaime Valiente Alemán." description="Asesoramiento jurídico y empresarial dirigido a particulares, autónomos y empresas en Cádiz y Arcos de la Frontera, con una atención cercana, personalizada, rigurosa y transparente." />
<section class="section"><div class="shell bio-grid"><aside class="bio-identity"><p class="eyebrow">Ámbitos de atención</p><p class="identity-title">Asuntos personales.<br /><em>Actividad empresarial.</em></p><p>Asesoramiento en Cádiz y Arcos de la Frontera.</p><nav aria-label="Servicios del despacho"><a class="text-link" href={href('particulares/')}>Servicios para particulares <span aria-hidden="true">→</span></a><a class="text-link" href={href('empresas/')}>Empresas y autónomos <span aria-hidden="true">→</span></a></nav></aside><div><p class="eyebrow">Una presentación con información contrastada</p><h2>Cercanía, rigor<br />y transparencia.</h2><p class="lead">La atención a particulares y el asesoramiento a empresas y autónomos forman parte de la oferta del despacho.</p><p>La propuesta reúne los asuntos civiles, de familia y sucesiones, penales y de reclamación de deudas, junto con las áreas mercantil, laboral, contable y fiscal.</p><div class="verification-list"><span class="verification-label">Datos pendientes de validar</span><h3>Información profesional de la versión definitiva</h3><ul><li>Titular legal y datos de identificación del prestador.</li><li>Titulación, colegio y número de colegiado.</li><li>Biografía contrastada y fotografía real autorizada.</li><li>Condiciones de atención y vigencia de los servicios.</li></ul><p class="small-note">Esta demo no atribuye trayectoria, acreditaciones, equipo, testimonios ni resultados que no estén documentados.</p></div></div></div></section>
<section class="section locations-section"><div class="shell"><div class="section-header"><div><p class="eyebrow">Las ubicaciones del despacho</p><h2>Cádiz y Arcos.</h2></div><p>Direcciones publicadas en la web actual. Su grafía y las condiciones de atención deben ratificarse antes de una publicación definitiva.</p></div><Offices /></div></section><ContactCta title="Hablemos de tu consulta." />
</Layout>
