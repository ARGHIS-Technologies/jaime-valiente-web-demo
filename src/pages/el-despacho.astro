---
import Layout from '../layouts/Layout.astro';
import VisualStudy from '../components/VisualStudy.astro';
import { visualStudies } from '../data/visualStudies';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import Offices from '../components/Offices.astro';
import ContactCta from '../components/ContactCta.astro';
import { href } from '../data/site';
---
<Layout current="el-despacho/" title="El despacho | Jaime Valiente Abogado" description="Jaime Valiente Alemán, abogado en Cádiz y Arcos de la Frontera. Asesoramiento jurídico y empresarial, atención cercana, personalizada y transparente.">
<section class="profile-hero"><div class="shell">
  <div class="breadcrumb"><a href={href()}>Inicio</a><span aria-hidden="true">/</span><span>El despacho</span></div>
  <div class="profile-visual-layout"><div><h1>Jaime Valiente<br />Alemán.</h1>
  <div class="profile-intro"><p>Asesoramiento jurídico y empresarial en Cádiz y Arcos de la Frontera. Atención cercana, personalizada, rigurosa y transparente.</p><a class="button button-dark" href={href('contacto/')}>Solicitar consulta<Arrow /></a></div>
</div><VisualStudy class="profile-signature" study={visualStudies.portrait} eager /></div></div></section>
<section class="section profile-section"><div class="shell profile-body"><h2>Ámbitos de<br />asesoramiento.</h2><div class="profile-overview"><p class="lead">Asesoramiento para tus asuntos personales y las necesidades de tu actividad profesional.</p><p>Puedes consultar asuntos civiles, de familia y sucesiones, penales y de reclamación de deudas, así como necesidades mercantiles, laborales, contables y fiscales.</p><nav class="profile-services" aria-label="Servicios del despacho"><a class="text-link" href={href('particulares/')}>Particulares<Arrow /></a><a class="text-link" href={href('empresas/')}>Empresas y autónomos<Arrow /></a><a class="text-link" href={href('reclamaciones/')}>Reclamaciones<Arrow /></a></nav></div></div></section>
<section class="visual-story"><div class="shell"><div class="visual-story-heading"><h2>Luz y espacio.</h2></div><div class="visual-story-pair"><VisualStudy study={visualStudies.interior} /><VisualStudy study={visualStudies.work} /></div></div></section>
<section class="section locations-section"><div class="shell"><div class="section-header"><div><h2>Cádiz y Arcos.</h2></div><p>Dos ubicaciones. Contacta para consultar las condiciones de atención antes de desplazarte.</p></div><Offices /></div></section><ContactCta title="Hablemos de tu consulta." />
</Layout>
