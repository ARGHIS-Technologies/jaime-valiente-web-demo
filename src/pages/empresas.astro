---
import Arrow from '../components/Arrow.astro';
import AreaNav from '../components/AreaNav.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceBlock from '../components/ServiceBlock.astro';
import ContactCta from '../components/ContactCta.astro';
import { href } from '../data/site';
---
<Layout current="empresas/" title="Asesoramiento para empresas y autónomos | Jaime Valiente" description="Asesoramiento jurídico y mercantil, laboral, contable y fiscal para empresas y autónomos.">
<PageHero eyebrow="Empresas y autónomos" title="Empresas y autónomos." description="Servicios jurídicos, mercantiles, laborales, contables y fiscales para tu actividad." action="Consultar sobre mi empresa" dark />
<div class="shell area-layout"><AreaNav audience="empresas" areas={[{id:'mercantil',label:'Jurídico y mercantil'},{id:'laboral',label:'Laboral'},{id:'contable-fiscal',label:'Contable y fiscal'}]} /><div>
<ServiceBlock id="mercantil" title="Jurídico y mercantil" items={['Asesoramiento jurídico a sociedades y empresas','Constitución y organización de sociedades','Preparación y redacción de actas','Convocatoria y celebración de juntas de socios','Redacción y revisión de contratos mercantiles','Asesoramiento en acuerdos y operaciones empresariales']} action="Consultar sobre mi empresa" />
<ServiceBlock id="laboral" title="Asesoramiento laboral" items={['Elaboración y gestión de nóminas','Gestión de seguros sociales','Contratación laboral','Procedimientos laborales','Despidos, sanciones y reclamaciones laborales']} action="Consultar sobre el área laboral" />
<ServiceBlock id="contable-fiscal" title="Contable y fiscal" items={['Llevanza y supervisión de contabilidades','Organización y control contable','Elaboración de informes contables','Asesoramiento fiscal a empresas y autónomos','Preparación y presentación de impuestos','Planificación fiscal','Atención a requerimientos y procedimientos tributarios']} action="Consultar sobre contabilidad o fiscalidad" />
<div class="related-card"><h3>Reclamación de deudas</h3><p>Negociación, reclamación judicial y ejecución de resoluciones para cantidades pendientes de cobro.</p><a class="text-link" href={href('reclamaciones/')}>Ir a Reclamaciones <Arrow /></a></div></div></div>
<ContactCta title="Hablemos de tu empresa." description="Concreta el alcance y las condiciones del asesoramiento en una consulta." action="Consultar sobre mi empresa" />
</Layout>
