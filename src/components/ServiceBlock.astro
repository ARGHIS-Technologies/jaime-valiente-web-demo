---
import { href } from '../data/site';
import Arrow from './Arrow.astro';
interface Props { id: string; number: string; title: string; intro: string; items: string[]; action?: string; }
const { id, number, title, intro, items, action = 'Consultar este asunto' } = Astro.props;
---
<section id={id} class="service-block" tabindex="-1" aria-labelledby={`${id}-title`}><div class="service-title"><span class="section-number">{number}</span><h2 id={`${id}-title`}>{title}</h2></div><div class="service-body"><p class="service-intro">{intro}</p>{items.length > 0 && <ul class="service-list">{items.map(item => <li>{item}</li>)}</ul>}<slot /><a class="text-link" href={href('contacto/')}>{action}<Arrow /></a></div></section>
