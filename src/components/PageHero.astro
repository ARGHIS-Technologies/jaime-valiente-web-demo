---
import { href } from '../data/site';
import Arrow from './Arrow.astro';
interface Props { eyebrow: string; title: string; description: string; action?: string; dark?: boolean; }
const { eyebrow, title, description, action = 'Solicitar consulta', dark = false } = Astro.props;
---
<section class:list={['page-hero', { 'page-hero-dark': dark }]}><div class="shell"><div class="breadcrumb"><a href={href()}>Inicio</a><span aria-hidden="true">/</span><span>{eyebrow}</span></div><div class="page-hero-grid"><h1>{title}</h1><div class="page-hero-aside"><p class="lead">{description}</p><a class="button button-dark" href={href('contacto/')}>{action}<Arrow /></a></div></div></div></section>
