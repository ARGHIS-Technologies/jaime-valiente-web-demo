---
import { href } from '../data/site';
import Arrow from './Arrow.astro';
interface Props { eyebrow: string; title: string; description: string; action?: string; dark?: boolean; number?: string; }
const { eyebrow, title, description, action = 'Solicitar consulta', dark = false, number } = Astro.props;
---
<section class:list={['page-hero', { 'page-hero-dark': dark }]}><div class="shell"><div class="breadcrumb"><a href={href()}>Inicio</a><span aria-hidden="true">/</span><span>{eyebrow}</span></div><div class="page-hero-grid"><div><p class="eyebrow">{number && <span>{number} / </span>}{eyebrow}</p><h1>{title}</h1></div><div class="page-hero-aside"><p class="lead">{description}</p><a class:list={['button', dark ? 'button-light' : 'button-dark']} href={href('contacto/')}>{action}<Arrow /></a></div></div></div></section>
