---
import { contact, href, navigation } from '../data/site';
---
<footer class="site-footer">
  <div class="shell footer-top"><div><a class="wordmark footer-brand" href={href()} aria-label="Jaime Valiente Alemán, abogado. Inicio"><span>Jaime Valiente</span><span class="wordmark-sub">ALEMÁN · ABOGADO</span></a><p class="footer-intro">Asesoramiento jurídico y empresarial.<br />Cádiz y Arcos de la Frontera.</p></div><div class="footer-col"><p class="footer-label">El despacho</p>{navigation.slice(1).map(item => <a href={href(item.path)}>{item.label}</a>)}</div><div class="footer-col"><p class="footer-label">Hablemos</p><a href={contact.tel}>{contact.phone}</a><a href={contact.mailto}>{contact.email}</a><a href={href('area-clientes/')}>Área de clientes <span aria-hidden="true">↗</span></a><p class="footer-small">Sin formularios ni recepción de<br />documentos en esta demo.</p></div></div>
  <div class="shell footer-bottom"><p>Demo de diseño · Contenidos sujetos a validación.</p><nav aria-label="Información legal demostrativa"><a href={href('aviso-legal/')}>Aviso legal</a><a href={href('privacidad/')}>Privacidad</a><a href={href('cookies/')}>Cookies</a></nav><a class="back-top" href="#contenido">Volver arriba ↑</a></div>
</footer>
