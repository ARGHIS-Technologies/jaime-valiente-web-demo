---
import { contact, href, navigation } from '../data/site';
import Icon from './Icon.astro';
---
<footer class="site-footer">
  <div class="shell footer-top"><div><a class="wordmark footer-brand" href={href()}><span>Jaime Valiente</span><span class="wordmark-sub">ALEMÁN · ABOGADO</span><span class="sr-only"> · Inicio</span></a><p class="footer-intro">Asesoramiento jurídico y empresarial.<br />Cádiz y Arcos de la Frontera.</p></div><div class="footer-col"><p class="footer-label">El despacho</p>{navigation.slice(1).map(item => <a href={href(item.path)}>{item.label}</a>)}</div><div class="footer-col"><p class="footer-label">Hablemos</p><a class="footer-action" href={contact.tel}><Icon name="phone" size={18} />{contact.phone}</a><a class="footer-action" href={contact.mailto}><Icon name="envelope-simple" size={18} />{contact.email}</a><a class="footer-action" href={href('area-clientes/')}><Icon name="folder-simple" size={18} />Área de clientes</a><p class="footer-small">Sin formularios ni recepción de<br />documentos en esta demo.</p></div></div>
  <div class="shell footer-bottom"><p>Demo de diseño · Contenidos sujetos a validación.</p><nav aria-label="Información legal demostrativa"><a href={href('aviso-legal/')}>Aviso legal</a><a href={href('privacidad/')}>Privacidad</a><a href={href('cookies/')}>Cookies</a></nav><a class="back-top" href="#contenido">Volver arriba<Icon name="arrow-up" size={16} /></a></div>
</footer>
