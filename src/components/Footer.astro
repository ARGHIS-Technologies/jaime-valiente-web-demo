---
import { contact, documentsPortal, href, legal, navigation } from '../data/site';
import Icon from './Icon.astro';
---
<footer class="site-footer">
  <div class="shell footer-top"><div><a class="wordmark footer-brand" href={href()}><span>Jaime Valiente</span><span class="wordmark-sub">ALEMÁN · ABOGADO</span><span class="sr-only"> · Inicio</span></a><p class="footer-intro">Asesoramiento jurídico y empresarial.<br />Cádiz y Arcos de la Frontera.<br />Colegiado nº {legal.barNumber} · {legal.bar}</p></div><div class="footer-col"><p class="footer-label">El despacho</p>{navigation.slice(1).map(item => <a href={href(item.path)}>{item.label}</a>)}</div><div class="footer-col"><p class="footer-label">Hablemos</p><a class="footer-action" href={contact.tel}><Icon name="phone" size={18} />{contact.phone}</a><a class="footer-action" href={contact.mailto}><Icon name="envelope-simple" size={18} />{contact.email}</a><a class="footer-action" href={href('area-clientes/')}><Icon name="folder-simple" size={18} />Área de clientes</a><a class="footer-action" href={documentsPortal} rel="noopener"><Icon name="arrow-square-out" size={18} />Acceso del despacho</a><p class="footer-small">Envío de documentación mediante<br />enlace personal del despacho.</p></div></div>
  <div class="shell footer-bottom"><p>© 2026 Jaime Valiente Alemán · Abogado</p><nav aria-label="Información legal"><a href={href('aviso-legal/')}>Aviso legal</a><a href={href('privacidad/')}>Privacidad</a><a href={href('cookies/')}>Cookies</a><a href={href('accesibilidad/')}>Accesibilidad</a></nav><a class="back-top" href="#contenido">Volver arriba<Icon name="arrow-up" size={16} /></a></div>
</footer>
