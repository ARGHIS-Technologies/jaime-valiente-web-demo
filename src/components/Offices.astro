---
import { offices, href } from '../data/site';
import Arrow from './Arrow.astro';
const { compact = false } = Astro.props;
---
<div class:list={['offices-grid', { compact }]}>{offices.map(office => <article class="office"><h3>{office.city}</h3><address>{office.address}<br />{office.building}</address><a class="text-link" href={href('contacto/#canales')}>Consultar atención en {office.city === 'Cádiz' ? 'Cádiz' : 'Arcos'}<Arrow /></a></article>)}</div>
