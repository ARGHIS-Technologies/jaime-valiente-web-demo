---
import { offices, href } from '../data/site';
import Arrow from './Arrow.astro';
import Icon from './Icon.astro';
import VisualStudy from './VisualStudy.astro';
import { visualStudies } from '../data/visualStudies';
const { compact = false, studies = false } = Astro.props;
---
<div class:list={['offices-grid', { compact, 'offices-grid-with-studies': studies }]}>{offices.map(office => <article class="office">{studies && <VisualStudy study={office.city === 'Cádiz' ? visualStudies.cadiz : visualStudies.arcos} />}<div class="office-heading"><Icon name="map-pin" size={26} /><h3>{office.city}</h3></div><address>{office.address}<br />{office.building}</address><a class="text-link" href={href('contacto/#canales')}>Consultar atención en {office.city === 'Cádiz' ? 'Cádiz' : 'Arcos'}<Arrow /></a></article>)}</div>
