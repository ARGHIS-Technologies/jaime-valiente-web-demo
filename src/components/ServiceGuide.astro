---
import Arrow from './Arrow.astro';
import { href } from '../data/site';
interface Props {
  title: string;
  items: { title: string; text: string; path: string }[];
  business?: boolean;
}
const { title, items, business = false } = Astro.props;
---
<article class:list={['practice-group', { 'practice-business': business }]}>
  <h3>{title}</h3>
  <ul>{items.map(item => <li><a href={href(item.path)}><span><strong>{item.title}</strong><small>{item.text}</small></span><Arrow /></a></li>)}</ul>
</article>
