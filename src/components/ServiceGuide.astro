---
import Icon from './Icon.astro';
import { href } from '../data/site';
interface Props {
  title: string;
  items: { title: string; text: string; path: string }[];
  business?: boolean;
}
const { title, items, business = false } = Astro.props;
---
<article class:list={['practice-group', { 'practice-business': business }]}>
  <h3>{title}</h3>
  <ul>{items.map(item => <li><a href={href(item.path)}><span class="practice-heading"><strong>{item.title}</strong><Icon name="caret-right" class="arrow" /></span><small>{item.text}</small></a></li>)}</ul>
</article>
